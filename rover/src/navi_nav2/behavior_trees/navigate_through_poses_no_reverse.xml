
<!--
  This Behavior Tree replans the global path periodically at 1 Hz through an array of poses continuously
   and it also has recovery actions specific to planning / control as well as general system issues.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- 30, not 6. The operator's standing instruction: this rover gives up
       only when there is no way of reaching anywhere new that could lead to
       the waypoint, because in this yard a path is guaranteed to exist. Six
       retries is about a minute of trying - a live run aborted with status 6
       after the plan went empty for 22 s while the recoveries were still
       cycling, and the ground it needed was ground a spin would have shown
       it. Thirty is ten full turns of the Clear/Spin/Wait round robin. The
       cost of being wrong here is the mission clock, which the operator can
       stop with Abort at any moment; the cost of being wrong the other way
       is a run that ends while a path was still there to find. -->
    <RecoveryNode number_of_retries="30" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="0.333">
          <!-- Three attempts, not one: clearing the global costmap and asking
                 again is cheap, and the phantom lethal splashes this stack
                 fights are exactly the kind that one clear does not always
                 remove. -->
          <RecoveryNode number_of_retries="3" name="ComputePathThroughPoses">
            <ReactiveSequence>
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
            </ReactiveSequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <!-- Same reasoning as the planner above: a local costmap cleared once
               may still hold the noise that stalled the controller. -->
          <RecoveryNode number_of_retries="3" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
