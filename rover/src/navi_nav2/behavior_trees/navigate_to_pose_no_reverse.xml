
<!--
  This Behavior Tree replans the global path periodically at 1 Hz and it also has
  recovery actions specific to planning / control as well as general system issues.
  This will be continuous if a kinematically valid planner is selected.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- 30, not 6. The operator's standing instruction: this rover gives up
       only when there is no way of reaching anywhere new that could lead to
       the waypoint, because in this yard a path is guaranteed to exist. Six
       retries is about a minute of trying - a live run aborted with status 6
       after the plan went empty for 22 s while the recoveries were still
       cycling, and the ground it needed was ground a spin would have shown
       it. Thirty is ten full turns of the Clear/Spin/Wait round robin. The
       cost of being wrong here is the mission clock, which the operator can
       stop with Abort at any moment; the cost of being wrong the other way
       is a run that ends while a path was still there to find. -->
    <RecoveryNode number_of_retries="30" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <!-- Three attempts, not one: clearing the global costmap and asking
                 again is cheap, and the phantom lethal splashes this stack
                 fights are exactly the kind that one clear does not always
                 remove. -->
          <RecoveryNode number_of_retries="3" name="ComputePathToPose">
            <!-- Theta* first; when it refuses ("Either of the start or goal
                 pose are an obstacle!" - live, a night waypoint inside a
                 phantom lethal splash), SmacBased retries the same goal
                 with its tolerance: it plans to the nearest valid pose
                 within 0.5 m instead of aborting the run over centimetres.
                 Holes stay lethal to DRIVE over either way - this only
                 stops a bad goal cell from ending the mission. -->
            <Fallback name="PlanOrNearest">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="SmacBased"/>
            </Fallback>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <Sequence name="FollowPathVerified">
          <!-- Same reasoning as the planner above: a local costmap cleared once
               may still hold the noise that stalled the controller. -->
          <RecoveryNode number_of_retries="3" name="FollowPath">
            <FollowPath path="{path}" controller_id="FollowPath"/>
            <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
          </RecoveryNode>
          <!-- The controller's own goal check runs in the odom frame against
               the path end transformed map->odom, and Nav2 humble ignores a
               failed transform there (nav2_controller isGoalReached), so a tf
               hiccup compares the rover against a default-constructed pose at
               the odom origin - which is exactly where the rover sits while it
               point-turns at the start of a run.  With yaw freed at the goal
               checker that comparison passes and the goal "succeeds" the
               moment the turn begins.  This condition re-measures the distance
               to the real goal in the map frame (goal_reached_tol on
               bt_navigator, looser than the controller's 0.25 so a genuine
               arrival never flaps) and fails safe when the pose is not
               available: a run that cannot know where it is must not claim
               arrival. -->
          <GoalReached goal="{goal}" global_frame="map" robot_base_frame="base_footprint"/>
        </Sequence>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <!-- Clear, then LOOK AROUND, then wait. The Spin is back by operator
             request, and with a better justification than it left with: a
             "poisoned" map around the rover (night z-drift phantoms) heals
             only when the camera re-observes it, and a point turn on the
             wheel-proven trail is the one motion guaranteed to stand on
             traversable ground while sweeping the camera across the cage.
             Its own collision check may still cut a turn short against
             phantom walls - a partial look is still new observations, and
             the RoundRobin comes back to it next round. BackUp stays out:
             reversing is blind on this rover. -->
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
