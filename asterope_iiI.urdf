<!-- 2 black panels, front (+X) and rear (-X). Outer faces at x = +/-0.3405
             (681 mm apart), 12 mm above the blue box top face, 30 mm tall. -->
        <visual>
            <origin xyz="-0.322 0 0.154" rpy="0 0 0"/>
            <geometry>
                <box size="0.037 0.188 0.03"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="-0.322 0 0.154" rpy="0 0 0"/>
            <geometry>
                <box size="0.037 0.188 0.03"/>
            </geometry>
        </collision>

        <visual>
            <origin xyz="0.322 0 0.154" rpy="0 0 0"/>
            <geometry>
                <box size="0.037 0.188 0.03"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0.322 0 0.154" rpy="0 0 0"/>
            <geometry>
                <box size="0.037 0.188 0.03"/>
            </geometry>
        </collision>


        <!-- 2 white blocks, one beneath each black panel.
             43 x 68 x 50 mm, top face flush with the panel underside at z=0.139. -->
        <visual>
            <origin xyz="-0.322 0 0.114" rpy="0 0 0"/>
            <geometry>
                <box size="0.043 0.068 0.05"/>
            </geometry>
            <material name="white"/>
