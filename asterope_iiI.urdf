    </link>


    <!--
      ZED 2i x2, frames only. Layout and offsets copied from
      stereolabs/zed-ros2-wrapper : zed_wrapper/urdf/zed_macro.urdf.xacro
        camera_link   = 1/4" mounting screw (NOT the optical centre)
        camera_center = camera_link + (0, 0, 0.015)
        left  frame   = camera_center + (-0.01, +0.06, 0)   baseline 0.12
        right frame   = camera_center + (-0.01, -0.06, 0)
        *_optical     = pure rotation (-pi/2, 0, -pi/2), z fwd / x right / y down
      Image + camera_info topics carry the *_optical frame id.
      mag/baro/temp links are gated to model 'zed2' upstream, so a 2i has none.

      Placed from the measured LEFT optical centres:
        front (0.335, +0.060, 0.154) facing +X
        rear  (-0.335, -0.060, 0.154) facing -X
      Launch with publish_tf:=false so robot_state_publisher owns these frames.
    -->
    <link name="zed_front_camera_link"/>

    <joint name="zed_front_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="zed_front_camera_link"/>
        <origin xyz="0.345 0 0.139" rpy="0 0 0"/>
    </joint>

    <link name="zed_front_camera_center"/>

    <joint name="zed_front_camera_center_joint" type="fixed">
        <parent link="zed_front_camera_link"/>
        <child link="zed_front_camera_center"/>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </joint>

    <link name="zed_front_left_camera_frame"/>

    <joint name="zed_front_left_camera_joint" type="fixed">
        <parent link="zed_front_camera_center"/>
        <child link="zed_front_left_camera_frame"/>
        <origin xyz="-0.01 0.06 0" rpy="0 0 0"/>
    </joint>

    <link name="zed_front_left_camera_frame_optical"/>

    <joint name="zed_front_left_camera_optical_joint" type="fixed">
        <parent link="zed_front_left_camera_frame"/>
        <child link="zed_front_left_camera_frame_optical"/>
        <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
    </joint>

    <link name="zed_front_right_camera_frame"/>

    <joint name="zed_front_right_camera_joint" type="fixed">
        <parent link="zed_front_camera_center"/>
        <child link="zed_front_right_camera_frame"/>
        <origin xyz="-0.01 -0.06 0" rpy="0 0 0"/>
    </joint>

    <link name="zed_front_right_camera_frame_optical"/>

    <joint name="zed_front_right_camera_optical_joint" type="fixed">
        <parent link="zed_front_right_camera_frame"/>
        <child link="zed_front_right_camera_frame_optical"/>
        <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
    </joint>

    <link name="zed_rear_camera_link"/>

    <joint name="zed_rear_camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="zed_rear_camera_link"/>
        <origin xyz="-0.345 0 0.139" rpy="0 0 3.141592654"/>
    </joint>

    <link name="zed_rear_camera_center"/>

    <joint name="zed_rear_camera_center_joint" type="fixed">
        <parent link="zed_rear_camera_link"/>
        <child link="zed_rear_camera_center"/>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
    </joint>

    <link name="zed_rear_left_camera_frame"/>

    <joint name="zed_rear_left_camera_joint" type="fixed">
        <parent link="zed_rear_camera_center"/>
        <child link="zed_rear_left_camera_frame"/>
        <origin xyz="-0.01 0.06 0" rpy="0 0 0"/>
    </joint>

    <link name="zed_rear_left_camera_frame_optical"/>

    <joint name="zed_rear_left_camera_optical_joint" type="fixed">
        <parent link="zed_rear_left_camera_frame"/>
        <child link="zed_rear_left_camera_frame_optical"/>
        <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
    </joint>

    <link name="zed_rear_right_camera_frame"/>

    <joint name="zed_rear_right_camera_joint" type="fixed">
        <parent link="zed_rear_camera_center"/>
        <child link="zed_rear_right_camera_frame"/>
        <origin xyz="-0.01 -0.06 0" rpy="0 0 0"/>
    </joint>

    <link name="zed_rear_right_camera_frame_optical"/>

    <joint name="zed_rear_right_camera_optical_joint" type="fixed">
        <parent link="zed_rear_right_camera_frame"/>
        <child link="zed_rear_right_camera_frame_optical"/>
        <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
    </joint>

    <gazebo reference="base_link">
        <static>true</static>
        <gravity>false</gravity>
        <kinematic>true</kinematic>
    </gazebo>

    <!-- 4 wheels: 910 mm square (centre-to-centre), 250 mm diameter,
         200 mm wide, axle across Y at z = -0.284 so the tread meets
         the ground at -0.409. One link each: a wheel baked into
         base_link could neither be steered nor coloured separately. -->

    <link name="steer_front_left">
        <!-- Nominal inertial, not measured: a steering housing needs some
             plausible mass/inertia here only because Gazebo's URDF->SDF
             conversion silently drops any link on a non-fixed joint that
             has none. Not hardware data. -->
        <inertial>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.0030" ixy="0.0" ixz="0.0"
                     iyy="0.0030" iyz="0.0" izz="0.0018"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.06" length="0.16"/>
            </geometry>
            <material name="silver"/>
        </visual>
    </link>

    <joint name="steer_front_left_joint" type="revolute">
        <parent link="base_link"/>
        <child link="steer_front_left"/>
        <origin xyz="0.455 0.455 -0.284" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <!-- One turn either way: the steer module is cabled, not a slip ring. -->
        <limit lower="-3.14159265" upper="3.14159265" effort="100" velocity="6.0"/>
    </joint>

    <link name="wheel_front_left">
        <!-- Nominal inertial, not measured: a wheel needs some plausible
             mass/inertia here only because Gazebo's URDF->SDF conversion
             silently drops any link on a non-fixed joint that has none.
             Not hardware data. -->
        <inertial>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <mass value="4.0"/>
            <inertia ixx="0.0290" ixy="0.0" ixz="0.0"
                     iyy="0.0290" iyz="0.0" izz="0.0313"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.200"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.200"/>
            </geometry>
        </collision>
    </link>

    <joint name="wheel_front_left_joint" type="continuous">
        <parent link="steer_front_left"/>
        <child link="wheel_front_left"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="steer_front_right">
        <!-- Nominal inertial, not measured: a steering housing needs some
             plausible mass/inertia here only because Gazebo's URDF->SDF
             conversion silently drops any link on a non-fixed joint that
             has none. Not hardware data. -->
        <inertial>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.0030" ixy="0.0" ixz="0.0"
                     iyy="0.0030" iyz="0.0" izz="0.0018"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.06" length="0.16"/>
            </geometry>
            <material name="silver"/>
        </visual>
    </link>

    <joint name="steer_front_right_joint" type="revolute">
        <parent link="base_link"/>
        <child link="steer_front_right"/>
        <origin xyz="0.455 -0.455 -0.284" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <!-- One turn either way: the steer module is cabled, not a slip ring. -->
        <limit lower="-3.14159265" upper="3.14159265" effort="100" velocity="6.0"/>
    </joint>

    <link name="wheel_front_right">
        <!-- Nominal inertial, not measured: a wheel needs some plausible
             mass/inertia here only because Gazebo's URDF->SDF conversion
             silently drops any link on a non-fixed joint that has none.
             Not hardware data. -->
        <inertial>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <mass value="4.0"/>
            <inertia ixx="0.0290" ixy="0.0" ixz="0.0"
                     iyy="0.0290" iyz="0.0" izz="0.0313"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.200"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.200"/>
            </geometry>
        </collision>
    </link>

    <joint name="wheel_front_right_joint" type="continuous">
        <parent link="steer_front_right"/>
        <child link="wheel_front_right"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="steer_rear_left">
        <!-- Nominal inertial, not measured: a steering housing needs some
             plausible mass/inertia here only because Gazebo's URDF->SDF
             conversion silently drops any link on a non-fixed joint that
             has none. Not hardware data. -->
        <inertial>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.0030" ixy="0.0" ixz="0.0"
                     iyy="0.0030" iyz="0.0" izz="0.0018"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.06" length="0.16"/>
            </geometry>
            <material name="silver"/>
        </visual>
    </link>

    <joint name="steer_rear_left_joint" type="revolute">
        <parent link="base_link"/>
        <child link="steer_rear_left"/>
        <origin xyz="-0.455 0.455 -0.284" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <!-- One turn either way: the steer module is cabled, not a slip ring. -->
        <limit lower="-3.14159265" upper="3.14159265" effort="100" velocity="6.0"/>
    </joint>

    <link name="wheel_rear_left">
        <!-- Nominal inertial, not measured: a wheel needs some plausible
             mass/inertia here only because Gazebo's URDF->SDF conversion
             silently drops any link on a non-fixed joint that has none.
             Not hardware data. -->
        <inertial>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <mass value="4.0"/>
            <inertia ixx="0.0290" ixy="0.0" ixz="0.0"
                     iyy="0.0290" iyz="0.0" izz="0.0313"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.200"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.200"/>
            </geometry>
        </collision>
    </link>

    <joint name="wheel_rear_left_joint" type="continuous">
        <parent link="steer_rear_left"/>
        <child link="wheel_rear_left"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="steer_rear_right">
        <!-- Nominal inertial, not measured: a steering housing needs some
             plausible mass/inertia here only because Gazebo's URDF->SDF
             conversion silently drops any link on a non-fixed joint that
             has none. Not hardware data. -->
        <inertial>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia ixx="0.0030" ixy="0.0" ixz="0.0"
                     iyy="0.0030" iyz="0.0" izz="0.0018"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.08" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.06" length="0.16"/>
            </geometry>
            <material name="silver"/>
        </visual>
    </link>

    <joint name="steer_rear_right_joint" type="revolute">
        <parent link="base_link"/>
        <child link="steer_rear_right"/>
        <origin xyz="-0.455 -0.455 -0.284" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <!-- One turn either way: the steer module is cabled, not a slip ring. -->
        <limit lower="-3.14159265" upper="3.14159265" effort="100" velocity="6.0"/>
    </joint>

    <link name="wheel_rear_right">
        <!-- Nominal inertial, not measured: a wheel needs some plausible
             mass/inertia here only because Gazebo's URDF->SDF conversion
             silently drops any link on a non-fixed joint that has none.
             Not hardware data. -->
        <inertial>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <mass value="4.0"/>
            <inertia ixx="0.0290" ixy="0.0" ixz="0.0"
                     iyy="0.0290" iyz="0.0" izz="0.0313"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.200"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
            <geometry>
                <cylinder radius="0.125" length="0.200"/>
            </geometry>
        </collision>
    </link>

    <joint name="wheel_rear_right_joint" type="continuous">
        <parent link="steer_rear_right"/>
        <child link="wheel_rear_right"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

</robot>
