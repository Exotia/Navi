<?xml version="1.0"?>
<!-- sim/src/navi_sim_bringup/urdf/asterope_sim.urdf.xacro

     The real robot plus the parts that exist only in simulation. Kept
     separate so asterope_iiI.urdf stays a description of the rover that
     exists, with no fictional camera on it. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="asterope">
  <!-- planar_move moves the model from /sim_cmd_vel. In semi-autonomous
       mode the body pose comes from the rover's localisation instead, and
       sim_ik_node writes it through /gazebo/set_entity_state - two writers
       of one model pose fight, and the picture jitters between them. So the
       launch expands this file with planar_move:=false in that mode. -->
  <xacro:arg name="planar_move" default="true"/>
  <xacro:include filename="$(find navi_sim_bringup)/urdf/asterope_base.urdf"/>

  <!-- Chase camera: rigidly behind and above the rover, looking down at it.
       Attached to the robot rather than free-flying, which makes following
       the rover automatic and needs no control channel back from the
       ground station - a video stream is one-way. -->
  <link name="chase_camera_link"/>
  <joint name="chase_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chase_camera_link"/>
    <origin xyz="-3.0 0 1.8" rpy="0 0.35 0"/>
  </joint>

  <gazebo reference="chase_camera_link">
    <sensor type="camera" name="chase_camera">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <!-- 672x376 matches what the rover streams, so the ground station
             panel gets the same frame size from either source. -->
        <image><width>672</width><height>376</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>200</far></clip>
      </camera>
      <plugin name="chase_camera_controller" filename="libgazebo_ros_camera.so">
        <ros><namespace>/sim_chase_camera</namespace></ros>
        <camera_name>chase</camera_name>
        <frame_name>chase_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Moves the model from /sim_cmd_vel without physics: exactly the
       kinematic body motion this simulation wants. Not loaded in
       semi-autonomous mode - see the argument at the top of this file. -->
  <xacro:if value="$(arg planar_move)">
    <gazebo>
      <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
        <ros><remapping>cmd_vel:=/sim_cmd_vel</remapping></ros>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odometry_frame>odom</odometry_frame>
        <publish_odom>false</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
      </plugin>
    </gazebo>
  </xacro:if>

  <!-- Sets joint positions from /set_joint_trajectory. -->
  <gazebo>
    <plugin name="joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <update_rate>30</update_rate>
    </plugin>
  </gazebo>

  <!-- The four steer and four wheel links carry mass, inertia and (for the
       wheels) collision cylinders only so they survive Gazebo's URDF->SDF
       conversion (see asterope_iiI.urdf) - not because this simulation wants
       contact physics, friction or inertia tuning. Gravity off keeps that
       mass/collision inert: motion here comes from planar_move and
       joint_pose_trajectory, never from the physics engine solving
       wheel-versus-ground contact. This lives in the sim-only xacro rather
       than the real URDF because it is a statement about the simulation,
       not a fact about the rover. -->
  <gazebo reference="steer_front_left"><gravity>false</gravity></gazebo>
  <gazebo reference="wheel_front_left"><gravity>false</gravity></gazebo>
  <gazebo reference="steer_front_right"><gravity>false</gravity></gazebo>
  <gazebo reference="wheel_front_right"><gravity>false</gravity></gazebo>
  <gazebo reference="steer_rear_left"><gravity>false</gravity></gazebo>
  <gazebo reference="wheel_rear_left"><gravity>false</gravity></gazebo>
  <gazebo reference="steer_rear_right"><gravity>false</gravity></gazebo>
  <gazebo reference="wheel_rear_right"><gravity>false</gravity></gazebo>

</robot>
